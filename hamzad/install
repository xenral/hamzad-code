#!/usr/bin/env bash
# Installs the Hamzad CLI.
#
#   curl -fsSL https://hamzad.ai/cli/install | bash
#   curl -fsSL https://github.com/xenral/hamzad-code/releases/latest/download/install | bash
#
# The version, the archive for this machine and its checksum are in two places: hamzad.ai/cli, and
# this repository's releases on GitHub. hamzad.ai is asked first; what it does not have, or cannot
# be reached for, is taken from the release.
# Derived from OpenCode's installer (MIT, Copyright (c) 2025 opencode); see NOTICE in the archive.
set -euo pipefail
APP=hamzad
# HAMZAD_CLI_URL names another copy of hamzad.ai/cli, such as freshly packed files on this machine.
# HAMZAD_CLI_RELEASES names another copy of the releases; set to nothing, only the first is asked.
BASE=${HAMZAD_CLI_URL:-https://hamzad.ai/cli}
BASE=${BASE%/}
RELEASES=${HAMZAD_CLI_RELEASES-https://github.com/xenral/hamzad-code/releases}
RELEASES=${RELEASES%/}

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
Hamzad CLI installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 2.3.2-hamzad.1)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL $BASE/install | bash
    curl -fsSL $BASE/install | bash -s -- --version 2.3.2-hamzad.1
    ./install --binary /path/to/hamzad
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.hamzad/bin
# Where the CLI looks for its own copy of ripgrep before it tries to download one.
TOOLS_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/hamzad/bin
mkdir -p "$INSTALL_DIR"

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    # Git Bash and MSYS2 run as emulated x64 on Windows ARM64, so `uname -m` reports x86_64.
    # The host CPU still shows in the `uname -s` suffix and in PROCESSOR_IDENTIFIER.
    if [ "$os" = "windows" ] && [ "$arch" = "x64" ]; then
      if [[ "$raw_os" == *-ARM64 || "${PROCESSOR_IDENTIFIER:-}" == ARM* ]]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64|windows-arm64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    if ! command -v tar >/dev/null 2>&1; then
        echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
        exit 1
    fi

    # Where each place keeps the newest version's description, and one version's files.
    places="site"
    if [ -n "$RELEASES" ]; then
        places="site releases"
    fi
    latest_at() {
        case "$1" in
            site) echo "$BASE/latest.json" ;;
            releases) echo "$RELEASES/latest/download/latest.json" ;;
        esac
    }
    files_at() {
        case "$1" in
            site) echo "$BASE/v/$2" ;;
            releases) echo "$RELEASES/download/$APP-v$2" ;;
        esac
    }

    if [ -z "$requested_version" ]; then
        specific_version=""
        for place in $places; do
            metadata=$(curl -fsSL --connect-timeout 15 "$(latest_at "$place")" 2>/dev/null || true)
            specific_version=$(echo "$metadata" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')
            if [ -n "$specific_version" ]; then
                break
            fi
        done

        if [ -z "$specific_version" ]; then
            echo -e "${RED}Failed to fetch version information from $BASE${RELEASES:+ or $RELEASES}${NC}"
            exit 1
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        specific_version=$requested_version
    fi

    # The archive comes from the first place that has it. A release's files are answered through a
    # redirect, so the question follows redirects.
    filename="$APP-$target.tar.gz"
    url=""
    for place in $places; do
        candidate=$(files_at "$place" "$specific_version")
        http_status=$(curl -s -o /dev/null -I -L --connect-timeout 15 -w "%{http_code}" "$candidate/$filename" || true)
        if [ "$http_status" = "200" ]; then
            url="$candidate/$filename"
            sums_url="$candidate/SHA256SUMS"
            break
        fi
    done
    if [ -z "$url" ]; then
        echo -e "${RED}Error: Version ${specific_version} is not available for $target${NC}"
        exit 1
    fi
    binary_name="$APP"
    if [ "$os" = "windows" ]; then
        binary_name="$APP.exe"
    fi
fi

check_version() {
    if command -v "$APP" >/dev/null 2>&1; then
        ## Check the installed version
        installed_version=$("$APP" --version 2>/dev/null || echo "")
        installed_version="${installed_version##* }"
        installed_version="${installed_version#v}"

        print_message info "${MUTED}Installed version: ${NC}$installed_version."
    fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        echo ""
    fi
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}$APP ${MUTED}version: ${NC}$specific_version"
    local tmp_dir="${TMPDIR:-/tmp}/hamzad_install_$$"
    mkdir -p "$tmp_dir"
    trap 'rm -rf "$tmp_dir"' EXIT

    local ret=0
    if [ -t 2 ]; then
        curl -f -# -L -o "$tmp_dir/$filename" "$url" || ret=$?
    else
        curl -fsSL -o "$tmp_dir/$filename" "$url" || ret=$?
    fi
    # curl exits 23 when it cannot write the file, usually because the temporary directory is full.
    if [ "$ret" -eq 23 ]; then
        print_message error "Could not write the download to $tmp_dir. Make sure it has enough free space, or set TMPDIR to another directory, then try again." >&2
    fi
    if [ "$ret" -ne 0 ]; then
        exit "$ret"
    fi

    # The archive is only unpacked when it is the file the release named.
    local expected actual
    expected=$(curl -fsSL "$sums_url" | awk -v file="$filename" '$2 == file || $2 == "*" file {print $1}' | head -n 1)
    actual=$(sha256_of "$tmp_dir/$filename")
    if [ -z "$expected" ]; then
        print_message error "No checksum is published for $filename; refusing to install it."
        exit 1
    fi
    if [ -z "$actual" ]; then
        print_message error "Cannot verify the download: none of sha256sum, shasum or openssl is installed."
        exit 1
    fi
    if [ "$expected" != "$actual" ]; then
        print_message error "The download does not match its checksum; refusing to install it.\n  expected $expected\n  got      $actual"
        exit 1
    fi

    tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    local unpacked="$tmp_dir/$APP-$target"
    mv "$unpacked/bin/$binary_name" "$INSTALL_DIR/$binary_name"
    chmod 755 "$INSTALL_DIR/$binary_name"

    # ripgrep comes with the archive so the first search needs no download. It goes where only the
    # CLI looks for it, not on PATH, so it never shadows a ripgrep the person installed.
    local rg="rg"
    if [ "$os" = "windows" ]; then
        rg="rg.exe"
    fi
    if [ -f "$unpacked/bin/$rg" ]; then
        mkdir -p "$TOOLS_DIR"
        mv "$unpacked/bin/$rg" "$TOOLS_DIR/$rg"
        chmod 755 "$TOOLS_DIR/$rg"
    fi
    rm -rf "$tmp_dir"
    trap - EXIT
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}$APP ${MUTED}from: ${NC}$binary_path"
    local installed_binary="$APP"
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) installed_binary="$APP.exe" ;;
    esac
    cp "$binary_path" "$INSTALL_DIR/$installed_binary"
    chmod 755 "$INSTALL_DIR/$installed_binary"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


path_added=false
add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# hamzad" >> "$config_file"
        echo "$command" >> "$config_file"
        path_added=true
        print_message info "${MUTED}Successfully added ${NC}hamzad ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "${SHELL:-sh}")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    # A new Mac has no ~/.zshrc, so create the shell's main config file rather than leaving hamzad off PATH.
    if [[ -z $config_file ]]; then
        case $current_shell in
            zsh) new_config_file="${ZDOTDIR:-$HOME}/.zshrc" ;;
            fish) new_config_file="$HOME/.config/fish/config.fish" ;;
            *) new_config_file="" ;;
        esac
        if [[ -n $new_config_file ]] && mkdir -p "$(dirname "$new_config_file")" 2>/dev/null && touch "$new_config_file" 2>/dev/null; then
            config_file=$new_config_file
        fi
    fi

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh|bash|ash|sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${MUTED}▄               ${NC}             ▄"
echo -e "${MUTED}█▀▀▄ █▀▀█ █▀█▀█ ${NC}▀▀▀█ █▀▀█ █▀▀█"
echo -e "${MUTED}█  █ █▀▀█ █ █ █ ${NC} ▄▀  █▀▀█ █  █"
echo -e "${MUTED}▀  ▀ ▀  ▀ ▀ ▀ ▀ ${NC}█▄▄▄ ▀  ▀ ▀▀▀▀"
echo -e ""
echo -e ""
echo -e "${MUTED}To start:${NC}"
echo -e ""
if [[ $path_added == "true" ]]; then
    echo -e "exec \$SHELL        ${MUTED}# Reload PATH (or open a new terminal)${NC}"
fi
echo -e "hamzad auth login  ${MUTED}# Sign in: approve this device in your Hamzad panel${NC}"
echo -e "cd <project>       ${MUTED}# Open a project${NC}"
echo -e "hamzad             ${MUTED}# Start${NC}"
echo -e ""
echo -e "${MUTED}For more information visit ${NC}https://hamzad.ai/cli"
echo -e ""
echo -e ""
