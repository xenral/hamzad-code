    "text": {
      "action": {
        "primary": { "$focused": "$hue.neutral.900" },
        "destructive": { "base": "$hue.neutral.900" }
      }
    },
    "scrollbar": { "base": "$hue.interactive.300" },
    "diff": {
      "text": { "context": "$hue.neutral.400" },
      "background": {
        "added": "#E1F2E9",
        "removed": "#FBE7EA",
        "context": "$hue.neutral.600"
      },
      "highlight": {
